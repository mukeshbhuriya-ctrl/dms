# =============================================================
#  DMS — Frontend Environment Variables (Example / Template)
#  Copy this file to .env (development) or .env.production
#  and fill in the values for your environment.
#  NEVER commit .env or .env.production to version control.
#
#  NOTE: All variables MUST be prefixed with VITE_ to be
#        accessible inside the React application.
# =============================================================

# ─── API Base URL ─────────────────────────────────────────────
# Development: point directly at the backend dev server
# Production:  point at the Nginx-proxied /api path or server IP
VITE_BACKEND_URL=http://localhost:3001
