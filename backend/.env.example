# =============================================================
#  DMS — Backend Environment Variables (Example / Template)
#  Copy this file to .env (development) or .env.production
#  and fill in the values for your environment.
#  NEVER commit .env or .env.production to version control.
# =============================================================

# ─── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                   # development | production

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/dms

# ─── Auth ─────────────────────────────────────────────────────
# Use a long, random string — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d                      # e.g. 1d | 7d | 30d

# ─── CORS ─────────────────────────────────────────────────────
# Origin(s) allowed to call the API (comma-separated if multiple)
# Development: http://localhost:5173
# Production:  http://<your-server-ip-or-domain>
CORS_ORIGIN=http://localhost:5173

# ─── App URLs ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ─── File Storage ─────────────────────────────────────────────
# Absolute path to the directory where uploaded files are stored
ROOT_DIR=D:/dms-data
# Maximum upload size in bytes (default: 1 GB = 1073741824)
MAX_FILE_SIZE=1073741824

# ─── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
# For Gmail: generate an App Password (not your real Gmail password)
SMTP_PASS=your_smtp_app_password
# Set to false to disable email sending (useful in development)
EMAIL_ENABLED=true

# ─── Roles ────────────────────────────────────────────────────
# Comma-separated list of default roles created for every company
DEFAULT_COMPANY_ROLES=ADMIN,DCC,WELD_PLAN_ADMIN,PRODUCTION_ENGINEER,QC_ENGINEER,USER,DCR,DESIGN_ENGINEER,MARKETING,TAXATION
