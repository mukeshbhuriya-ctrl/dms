model hydrostatic_test_report {
  id               String   @id @default(uuid())
  company_id       String
  job_id           String

  // Header Details
  msn              String
  serial_no        Int
  report_no        String
  client           String
  po_no            String
  project_id       String?
  equipment_name   String?
  tag_no           String?
  code             String?

  // Test Details
  shreno_drg_no    String?
  customer_drg_no  String?
  construction_code String?
  chlorine_content  String?
  inspection_agency String?
  test_position     String?
  procedure_no      String?

  status           String   @default("draft")

  company  company  @relation(fields: [company_id], references: [id])
  job      job      @relation(fields: [job_id], references: [id])
  items    hydrostatic_test_item[]
  remarks  hydrostatic_test_remark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model hydrostatic_test_item {
  id                     String  @id @default(uuid())
  hydro_report_id        String
  sort_order             Int

  particulars            String?
  mawp_int_ext           String?
  required_test_pressure String?
  actual_test_pressure   String?
  
  // Pressure Gauge Details
  pg1_range              String?
  pg1_id_no              String?
  pg1_calib_date         String?
  pg1_due_date           String?

  pg2_range              String?
  pg2_id_no              String?
  pg2_calib_date         String?
  pg2_due_date           String?

  holding_time           String?
  test_result            String?

  hydro_report hydrostatic_test_report @relation(fields: [hydro_report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model hydrostatic_test_remark {
  id               String  @id @default(uuid())
  hydro_report_id  String
  sort_order       Int
  text             String?

  hydro_report hydrostatic_test_report @relation(fields: [hydro_report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
