// -------------------------------------------------------------
// NCR Models
// -------------------------------------------------------------

model ncr {
  id              String   @id @default(uuid())
  company_id      String
  job_id          String

  // Basic Details
  msn             String
  ncr_no          String
  date            DateTime?
  client          String?
  po_no           String?
  project_id      String?
  tag_no          String?
  drg_no          String?
  rev_no          String?

  // Stage 1
  description_non_conformance String?
  ncr_raised_at   String?
  ncr_raised_by   String?
  ncr_date        DateTime?
  attachments     Json?

  // Stage 2
  proposed_resolution String?
  resolution_by   String?
  resolution_date DateTime?
  
  target_engineer_id      String?
  target_head_design_id   String?
  target_head_welding_id  String?
  target_head_quality_id  String?

  // Stage 3
  resolution_approval Json?
  acceptance_date     DateTime?

  design_review_status String? @default("PENDING")
  head_design_comments String?

  welding_review_status String? @default("PENDING")
  head_welding_comments String?

  quality_review_status String? @default("PENDING")
  head_quality_comments String?

  // Stage 4
  corrective_action_verified_by String?
  corrective_action_comments    String?
  corrective_action_date        DateTime?
  verified_by_qce_id            String?

  // Stage 5
  disposition                   String?
  verified_by_head_quality_id   String?
  disposition_date              DateTime?

  // Workflow tracking
  status          String   @default("OPEN") 
  current_stage   Int      @default(1)
  ncr_status      String   @default("draft")

  // Relations
  company  company  @relation(fields: [company_id], references: [id])
  job      job      @relation(fields: [job_id], references: [id])

  initiator           user? @relation("NcrRaisedBy", fields: [ncr_raised_by], references: [id])
  raised_at_user      user? @relation("NcrRaisedAt", fields: [ncr_raised_at], references: [id])
  resolution_user     user? @relation("NcrResolutionBy", fields: [resolution_by], references: [id])
  target_engineer     user? @relation("NcrTargetEngineer", fields: [target_engineer_id], references: [id])
  target_head_design  user? @relation("NcrTargetHeadDesign", fields: [target_head_design_id], references: [id])
  target_head_welding user? @relation("NcrTargetHeadWelding", fields: [target_head_welding_id], references: [id])
  target_head_quality user? @relation("NcrTargetHeadQuality", fields: [target_head_quality_id], references: [id])
  corrective_action_verifier user? @relation("NcrCorrectiveActionVerifiedBy", fields: [corrective_action_verified_by], references: [id])
  qce_verifier        user? @relation("NcrVerifiedByQce", fields: [verified_by_qce_id], references: [id])
  head_quality_verifier user? @relation("NcrVerifiedByHeadQuality", fields: [verified_by_head_quality_id], references: [id])

  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model email_template {
  id         String   @id @default(uuid())
  company_id String
  name       String
  subject    String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    company  @relation(fields: [company_id], references: [id])

  @@unique([company_id, name])
}

model notification {
  id            String   @id @default(uuid())
  company_id    String
  user_id       String
  kind          String   @default("system") // action | system
  severity      String   @default("info")   // info | warning | critical | success
  title         String
  message       String   @db.Text
  action_path   String?
  action_params Json?
  signature     String?
  is_read       Boolean  @default(false)
  read_at       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, createdAt(sort: Desc)])
  @@index([company_id, createdAt(sort: Desc)])
  @@index([user_id, signature])
}

