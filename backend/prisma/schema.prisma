// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model company{
  id String @id @default(uuid())
  name String
  logo_url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users user[]
  roles role[]
  customers customer[]
  customer_locations customer_location[]
  pos po[]
  po_communication_matrix po_communication_matrix[]
  jobs job[]
  document_master document_master[]
  single_document single_document[]
  group group[]
  job_group job_group[]
  group_document group_document[]
  document_type document_type[]
  weld_joint_plans weld_joint_plan[]
  transmissions transmission[]
  departments department[]
  material_heat_charts material_heat_chart[]
  dish_end_inspection_reports dish_end_inspection_report[]
  final_inspection_reports final_inspection_report[]
  qaps qap[]
}

model department {
  id        String   @id @default(uuid())
  company_id String
  name      String
  
  company   company  @relation(fields: [company_id], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([company_id, name]) // Ensure department names are unique per company
}

model role{
  id String @id @default(uuid())
  company_id String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  user_roles user_roles[]
}

 

model user{
  id String @id @default(uuid())
  name String
  email String @unique
  empid String @unique
  mobile String? @unique
  password String
  company_id String
  department String?
  designation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  user_roles user_roles[]
  single_document single_document[]
  group_document group_document[]
  weld_joint_plans_created weld_joint_plan[]
  uploaded_versions document_version[]
  created_transmissions transmission[]
  assigned_dish_end_reports dish_end_inspection_report[]
  final_inspection_reports final_inspection_report[]
  assigned_qap_details qap_detail[]
}

model user_roles{
  id String @id @default(uuid())
  user_id String
  role_id String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id])
  role role @relation(fields: [role_id], references: [id])
}

model siteadmin{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model customer{
  id String @id @default(uuid())
  company_id String
  customer_name String
  customer_short_name String
  email String 
  mobile String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])

  customer_locations customer_location[]
  pos po[]
  jobs job[]
  group_document group_document[]
  single_document single_document[]
  transmissions transmission[]
}


model customer_location{
  id String @id @default(uuid())
  company_id String
  customer_id String
  location_name String
  customer_number_as_per_sap String
  gst_number String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer customer @relation(fields: [customer_id], references: [id])
  company company @relation(fields: [company_id], references: [id])
  pos po[]
  jobs job[]
  group_document group_document[]
  single_document single_document[]
  transmissions transmission[]
}

model po{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_number String
  po_date DateTime
  po_doc_url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  company company @relation(fields: [company_id], references: [id])

  po_communication_matrix po_communication_matrix[]
  jobs job[]
  group_document group_document[]
  single_document single_document[]
  transmissions transmission[]
}

model po_communication_matrix{
  id String @id @default(uuid())
  company_id String
  po_id String
  name String
  email String
  type String // "shreno" or "client"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
  
}

model job{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_id String
  job_number String
  project_id String
  equipement_name String
  tag_number String
  code String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  po po @relation(fields: [po_id], references: [id])

  single_document single_document[]
  job_group job_group[]
  weld_joint_plans weld_joint_plan[]
  material_heat_charts material_heat_chart[]
  dish_end_inspection_reports dish_end_inspection_report[]
  final_inspection_reports final_inspection_report[]
  qaps qap[]
}

model document_type{
  id String @id @default(uuid())
  company_id String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  document_master document_master[]
}

model document_master{
  id String @id @default(uuid())
  company_id String
  document_number String
  document_name String
  document_type_id String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  document_type document_type @relation(fields: [document_type_id], references: [id])
  single_document single_document[]
  group_document group_document[]
}

model single_document{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_id String
  job_id String
  document_id String
  shreno_doc_no String?
  shreno_reference_no String?
  client_doc_no String?
  client_reference_no String?
  upload_due_days Int?
  response_due_days Int?
  user_id String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  document document_master @relation(fields: [document_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
  job job @relation(fields: [job_id], references: [id])
  user user? @relation(fields: [user_id], references: [id])
  
  status String @default("Pending") // Pending, Uploaded, Approved, Rejected
  versions document_version[]
  transmission_items transmission_document[]
}

model group{
  id String @id @default(uuid())
  company_id String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  job_group job_group[]
  group_document group_document[]
}

model job_group{
  id String @id @default(uuid())
  company_id String
  group_id String
  job_id String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  group group @relation(fields: [group_id], references: [id])
  job job @relation(fields: [job_id], references: [id])
}


model group_document{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_id String
  group_id String
  document_id String
  shreno_doc_no String?
  shreno_reference_no String?
  client_doc_no String?
  client_reference_no String?
  upload_due_days Int?
  response_due_days Int?
  user_id String
  status String @default("Pending") // Pending, Uploaded, Approved, Rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  group group @relation(fields: [group_id], references: [id])
  document document_master @relation(fields: [document_id], references: [id])
  user user @relation(fields: [user_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
  versions document_version[]
  transmission_items transmission_document[]
}




model weld_joint_plan {
  id                  String   @id @default(uuid())
  company_id          String
  job_id              String
  
  shreno_drg_no       String
  customer_drg_no     String?
  code_of_construction String
  weld_plan_no        String
  serial_no           Int
  
  company   company @relation(fields: [company_id], references: [id])
  job       job     @relation(fields: [job_id], references: [id])
  
  weld_joints weld_joint[]
  
  created_by          String?
  creator             user?   @relation(fields: [created_by], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model weld_joint {
  id                      String   @id @default(uuid())
  weld_joint_plan_id      String
  
  joint_no                String
  joint_type              String
  joint_description       String
  
  base_metal_thickness_p1 String?
  base_metal_thickness_p2 String?
  
  base_metal_spec_p1      String?
  base_metal_spec_p2      String?
  
  consumable              String?
  wps_pqr_no              String?
  process                 String?
  impact_test             String?
  
  back_chip_req           Boolean?
  pwht                    Boolean?
  rt                      Boolean?
  pt                      Boolean?
  remarks                 String?
  
  weld_joint_plan weld_joint_plan @relation(fields: [weld_joint_plan_id], references: [id], onDelete: Cascade)
  weld_joint_inspection weld_joint_inspection?
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model weld_joint_inspection {
  id              String   @id @default(uuid())
  weld_joint_id   String   @unique
  weld_joint      weld_joint @relation(fields: [weld_joint_id], references: [id], onDelete: Cascade)

  // --- Common Data store for all stages based on {ab: {...}. cd: {...}}---
  data_json         Json?    


  // --- Stage 1: Seam Inspection ---
  s1_status       String   @default("pending") // pending, submitted, approved, rejected
  s1_data         Json?    
  s1_prod_eng_id  String?
  s1_qc_eng_id    String?
  s1_submitted_at DateTime?
  s1_approved_at  DateTime?
  s1_rejected_at  DateTime?

  // --- Stage 2: Back Chip ---
  s2_status       String   @default("pending")
  s2_data         Json?
  s2_prod_eng_id  String?
  s2_qc_eng_id    String?
  s2_submitted_at DateTime?
  s2_approved_at  DateTime?
  s2_rejected_at  DateTime?

  // --- Stage 3: Weld Visual ---
  s3_status       String   @default("pending")
  s3_data         Json?
  s3_prod_eng_id  String?
  s3_qc_eng_id    String?
  s3_submitted_at DateTime?
  s3_approved_at  DateTime?
  s3_rejected_at  DateTime?

  // --- Stage 4: RT ---
  s4_status       String   @default("pending")
  s4_data         Json?
  s4_prod_eng_id  String?
  s4_qc_eng_id    String?
  s4_submitted_at DateTime?
  s4_approved_at  DateTime?
  s4_rejected_at  DateTime?

  // --- Stage 5: PT ---
  s5_status       String   @default("pending")
  s5_data         Json?
  s5_prod_eng_id  String?
  s5_qc_eng_id    String?
  s5_submitted_at DateTime?
  s5_approved_at  DateTime?
  s5_rejected_at  DateTime?

  // --- Stage 6: PWHT - Radiography Testing (RT) (After PWHT) ---
  s6_status       String   @default("pending")
  s6_data         Json?
  s6_prod_eng_id  String?
  s6_qc_eng_id    String?
  s6_submitted_at DateTime?
  s6_approved_at  DateTime?
  s6_rejected_at  DateTime?

  // --- Stage 7: PWHT - Penetrant Testing (PT) (After PWHT) ---
  s7_status       String   @default("pending")
  s7_data         Json?
  s7_prod_eng_id  String?
  s7_qc_eng_id    String?
  s7_submitted_at DateTime?
  s7_approved_at  DateTime?
  s7_rejected_at  DateTime?

  // --- Stage 8: Final Inspection (CD) ---
  s8_status       String   @default("pending")
  s8_data         Json?
  s8_prod_eng_id  String?
  s8_qc_eng_id    String?
  s8_submitted_at DateTime?
  s8_approved_at  DateTime?
  s8_rejected_at  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model document_version {
  id                 String   @id @default(uuid())
  single_document_id String?
  group_document_id  String?
  version_no         Int
  file_url           String
  remarks            String?
  status             String   @default("Uploaded") // Uploaded, Approved, Rejected
  uploaded_by        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  single_document single_document? @relation(fields: [single_document_id], references: [id])
  group_document  group_document?  @relation(fields: [group_document_id], references: [id])
  uploader        user             @relation(fields: [uploaded_by], references: [id])
  transmission_items transmission_document[]
}

model transmission {
  id                   String   @id @default(uuid())
  company_id           String
  transmission_number  String   @unique
  customer_id          String
  customer_location_id String
  po_id                String
  zip_url              String?
  password             String
  status               String @default("Pending") // Pending, Sent
  client_status        String @default("Pending") // Pending, Approved, Rejected
  client_remarks       String?
  created_by           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company   company           @relation(fields: [company_id], references: [id])
  customer  customer          @relation(fields: [customer_id], references: [id])
  location  customer_location @relation(fields: [customer_location_id], references: [id])
  po        po                @relation(fields: [po_id], references: [id])
  creator   user              @relation(fields: [created_by], references: [id])
  documents transmission_document[]
}

model transmission_document {
  id                 String @id @default(uuid())
  transmission_id    String
  single_document_id String?
  group_document_id  String?
  version_id         String

  transmission    transmission     @relation(fields: [transmission_id], references: [id])
  single_document single_document? @relation(fields: [single_document_id], references: [id])
  group_document  group_document?  @relation(fields: [group_document_id], references: [id])
  version         document_version @relation(fields: [version_id], references: [id])
}


model material_heat_chart {
  id               String   @id @default(uuid())
  company_id       String
  job_id           String

  // Auto-filled from job on create
  msn              String
  serial_no        Int
  report_no        String
  client           String
  po_no            String
  project_id       String?
  equipment_name   String?
  tag_no           String?
  code             String?

  // User-editable
  shreno_drg_no    String?
  customer_drg_no  String?
  inspection_by    String?

  status           String   @default("draft")

  company  company  @relation(fields: [company_id], references: [id])
  job      job      @relation(fields: [job_id], references: [id])
  items    material_heat_chart_item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model material_heat_chart_item {
  id                String  @id @default(uuid())
  mhc_id            String
  sort_order        Int
  is_heading        Boolean @default(false)
  heading_text      String?
  parent_heading_id String?

  item_no           String?
  description       String?
  size              String?
  material_spec     String?
  quantity_unit     String?
  heat_no           String?
  mtr_no            String?
  manufacturer      String?
  remarks           String?

  mhc material_heat_chart @relation(fields: [mhc_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model dish_end_inspection_report {
  id              String   @id @default(uuid())
  company_id      String
  job_id          String

  msn             String
  report_no       String
  client          String
  po_no           String
  project_id      String?
  equipment_name  String?
  tag_no          String?
  code            String?

  drg_no          String?
  insp_agency     String?
  quality_engineer_id String?
  vendor_dish_end_number String?

  status          String   @default("draft")

  company   company  @relation(fields: [company_id], references: [id])
  job       job      @relation(fields: [job_id], references: [id])
  quality_engineer user? @relation(fields: [quality_engineer_id], references: [id])

  items       dish_end_inspection_item[]
  instruments dish_end_inspection_instrument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model dish_end_inspection_item {
  id          String   @id @default(uuid())
  report_id   String
  sr_no       Int
  description String
  as_per_drg  String?
  actual      String?
  remarks     String?

  report      dish_end_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model dish_end_inspection_instrument {
  id          String   @id @default(uuid())
  report_id   String
  name        String?
  id_no       String?
  due_date    String?

  report      dish_end_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// Final Inspection Report Models
// -------------------------------------------------------------

model final_inspection_report {
  id              String   @id @default(uuid())
  company_id      String
  job_id          String

  msn             String
  report_no       String
  client          String
  po_no           String
  project_id      String?
  equipment_name  String?
  tag_no          String?
  code            String?
  drg_no          String?
  
  quality_engineer_id String?
  status          String   @default("draft")

  company   company  @relation(fields: [company_id], references: [id])
  job       job      @relation(fields: [job_id], references: [id])
  quality_engineer user? @relation(fields: [quality_engineer_id], references: [id])

  details     final_inspection_detail[]
  nozzles     final_inspection_nozzle[]
  parts       final_inspection_part[]
  instruments final_inspection_instrument[]
  remarks     final_inspection_remark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model final_inspection_detail {
  id          String   @id @default(uuid())
  report_id   String
  sr_no       Int
  description String?
  required    String?
  actual      String?
  remarks     String?

  report      final_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model final_inspection_nozzle {
  id                  String   @id @default(uuid())
  report_id           String
  sr_no               Int
  nozzle_mark         String?
  orientation         String?
  size                String?
  location            String?
  elevation_approved  String?
  projection_approved String?
  elevation_actual    String?
  projection_actual   String?

  report      final_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model final_inspection_part {
  id                  String   @id @default(uuid())
  report_id           String
  sr_no               Int
  part_no             String?
  description         String?
  orientation_approved String?
  elevation_approved  String?
  projection_approved String?
  elevation_actual    String?
  projection_actual   String?

  report      final_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model final_inspection_instrument {
  id          String   @id @default(uuid())
  report_id   String
  name        String?
  id_no       String?
  due_date    String?

  report      final_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model final_inspection_remark {
  id          String   @id @default(uuid())
  report_id   String
  sr_no       Int
  text        String?

  report      final_inspection_report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// Quality Assurance Plan (QARP) Models
// -------------------------------------------------------------

model qap {
  id              String   @id @default(uuid())
  company_id      String
  job_id          String

  msn             String
  client          String
  po_no           String
  po_date         String?
  document_no     String
  equipment_name  String?
  tag_no          String?
  code            String?
  
  shreno_drg_no   String?
  customer_drg_no String?

  status          String   @default("draft")

  company   company  @relation(fields: [company_id], references: [id])
  job       job      @relation(fields: [job_id], references: [id])
  
  details   qap_detail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model qap_detail {
  id                 String   @id @default(uuid())
  qap_id             String
  
  sort_order         Int
  is_heading         Boolean  @default(false)
  heading_text       String?
  
  activity           String?
  type_method_check  String?
  acceptance_criteria String?
  verifying_document  String?
  shreno             String?
  assigned_user_id   String?
  client_tpia        String?
  remark             String?

  qap          qap    @relation(fields: [qap_id], references: [id], onDelete: Cascade)
  assigned_user user?  @relation(fields: [assigned_user_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
