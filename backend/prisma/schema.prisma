// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model company{
  id String @id @default(uuid())
  name String
  logo_url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users user[]
  roles role[]
  customers customer[]
  customer_locations customer_location[]
  pos po[]
  po_communication_matrix po_communication_matrix[]
  po_attachment_history po_attachment_history[]
  jobs job[]
  document_master document_master[]
  single_document single_document[]
  group group[]
  job_group job_group[]
  group_document group_document[]
  document_type document_type[]
  weld_joint_plans weld_joint_plan[]
  transmissions transmission[]
  drawing_transmittals drawing_transmittal[]
  departments department[]
  material_heat_charts material_heat_chart[]
  hydrostatic_test_reports hydrostatic_test_report[]
  dish_end_inspection_reports dish_end_inspection_report[]
  final_inspection_reports final_inspection_report[]
  quality_assurance_plans quality_assurance_plan[]
  dcr dcr[]
  dcr_change_request dcr_change_request[]
  rfq_registers rfq_register[]
  rfq_lookups rfq_lookup[]
  estimators estimator[]
  mediators mediator[]
  ncr ncr[]
  document_activities document_activity[]
  qc_groups qc_group[]
  email_templates email_template[]
  notifications notification[]
}

model department {
  id        String   @id @default(uuid())
  company_id String
  name      String
  
  company   company  @relation(fields: [company_id], references: [id])
  
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     user[]
  
  @@unique([company_id, name]) // Ensure department names are unique per company
}

model qc_group {
  id          String   @id @default(uuid())
  company_id  String
  name        String
  
  company     company  @relation(fields: [company_id], references: [id])
  users       user_qc_group[]
  weld_joint_stages weld_joint_stage[]

  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([company_id, name])
}

model user_qc_group {
  id          String   @id @default(uuid())
  user_id     String
  qc_group_id String

  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  qc_group    qc_group @relation(fields: [qc_group_id], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([user_id, qc_group_id])
}

model role{
  id String @id @default(uuid())
  company_id String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  user_roles user_roles[]
}

 

model user{
  id String @id @default(uuid())
  name String
  email String @unique
  empid String @unique
  mobile String? @unique
  password String
  company_id String
  department_id String? @map("department")
  department department? @relation(fields: [department_id], references: [id])
  designation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  user_roles user_roles[]
  single_document single_document[]
  group_document group_document[]
  document_activities document_activity[]
  weld_joint_plans_created weld_joint_plan[]
  created_transmissions transmission[]
  created_drawing_transmittals drawing_transmittal[]
  uploaded_versions document_version[]
  assigned_dish_end_reports dish_end_inspection_report[]
  final_inspection_reports final_inspection_report[]
  dcr_design_engineer dcr[] @relation("DcrDesignEngineer")
  dcr_quality_engineer dcr[] @relation("DcrQualityEngineer")
  mhc_production_reports material_heat_chart[] @relation("MhcProductionEngineer")
  mhc_qc_reports         material_heat_chart[] @relation("MhcQcEngineer")
  rfq_registers rfq_register[]
  drawing_versions drawing_version[]
  drawing_activities_performed drawing_activity[]

  // NCR relations
  ncr_raised_at_user ncr[] @relation("NcrRaisedAt")
  ncr_raised_by ncr[] @relation("NcrRaisedBy")
  ncr_resolution_by ncr[] @relation("NcrResolutionBy")
  ncr_target_engineer ncr[] @relation("NcrTargetEngineer")
  ncr_target_head_design ncr[] @relation("NcrTargetHeadDesign")
  ncr_target_head_welding ncr[] @relation("NcrTargetHeadWelding")
  ncr_target_head_quality ncr[] @relation("NcrTargetHeadQuality")
  ncr_corrective_action_verified_by ncr[] @relation("NcrCorrectiveActionVerifiedBy")
  ncr_verified_by_qce ncr[] @relation("NcrVerifiedByQce")
  ncr_verified_by_head_quality ncr[] @relation("NcrVerifiedByHeadQuality")
  qc_groups user_qc_group[]

  // Weld Inspection Trail relations
  weld_stage_prod_reports weld_joint_stage[] @relation("WeldStageProdEng")
  weld_stage_qc_reports   weld_joint_stage[] @relation("WeldStageQcEng")
  notifications notification[]

  otp String?
  otpExpiry DateTime?

  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
}

model user_roles{
  id String @id @default(uuid())
  user_id String
  role_id String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id])
  role role @relation(fields: [role_id], references: [id])
}

model siteadmin{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model customer{
  id String @id @default(uuid())
  company_id String
  customer_name String
  customer_short_name String
  email String 
  mobile String? 
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])

  customer_locations customer_location[]
  pos po[]
  jobs job[]
  group_document group_document[]
  single_document single_document[]
  transmissions transmission[]
}


model customer_location{
  id String @id @default(uuid())
  company_id String
  customer_id String
  location_name String
  customer_number_as_per_sap String
  gst_number String
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer customer @relation(fields: [customer_id], references: [id])
  company company @relation(fields: [company_id], references: [id])
  pos po[]
  jobs job[]
  group_document group_document[]
  single_document single_document[]
  transmissions transmission[]
}

model po{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_number String
  po_date DateTime
  po_doc_url String?
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  company company @relation(fields: [company_id], references: [id])

  po_communication_matrix po_communication_matrix[]
  po_attachment_history po_attachment_history[]
  jobs job[]
  group_document group_document[]
  single_document single_document[]
  transmissions transmission[]
}

model po_communication_matrix{
  id String @id @default(uuid())
  company_id String
  po_id String
  name String
  email String
  type String // "shreno" or "client"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
  
}

model po_attachment_history {
  id String @id @default(uuid())
  company_id String
  po_id String
  po_attachments Json @default("[]")
  revision Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
}

model job{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_id String
  job_number String
  project_id String?
  equipement_name String
  tag_number String
  code String?
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  po po @relation(fields: [po_id], references: [id])

  single_document single_document[]
  job_group job_group[]
  weld_joint_plans weld_joint_plan[]
  material_heat_charts material_heat_chart[]
  hydrostatic_test_reports hydrostatic_test_report[]
  dish_end_inspection_reports dish_end_inspection_report[]
  final_inspection_reports final_inspection_report[]
  quality_assurance_plans quality_assurance_plan[]
  dcr dcr[]
  dcr_change_request dcr_change_request[]

  ncr ncr[]
  drawing_transmittal_jobs drawing_transmittal_job[]
}

model document_type{
  id String @id @default(uuid())
  company_id String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  document_master document_master[]
}

model document_master{
  id String @id @default(uuid())
  company_id String
  serial_no Int @default(0)
  document_number String
  document_name String
  document_type_id String?
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  document_type document_type? @relation(fields: [document_type_id], references: [id])
  single_document single_document[]
  group_document group_document[]
  drawing_transmittal_items drawing_transmittal_item[]
  drawing_versions drawing_version[]
  drawing_activities drawing_activity[]
}

model single_document{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_id String
  job_id String
  document_id String
  shreno_doc_no String?
  shreno_reference_no String?
  client_doc_no String?
  client_reference_no String?
  upload_due_days Int?
  response_due_days Int?
  user_id String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  document document_master @relation(fields: [document_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
  job job @relation(fields: [job_id], references: [id])
  user user? @relation(fields: [user_id], references: [id])
  
  status String @default("Pending") // Pending, Uploaded, Approved, Rejected
  versions document_version[]
  transmission_items transmission_document[]
}

model group{
  id String @id @default(uuid())
  company_id String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  job_group job_group[]
  group_document group_document[]
}

model job_group{
  id String @id @default(uuid())
  company_id String
  group_id String
  job_id String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  group group @relation(fields: [group_id], references: [id])
  job job @relation(fields: [job_id], references: [id])
}


model group_document{
  id String @id @default(uuid())
  company_id String
  customer_id String
  customer_location_id String
  po_id String
  group_id String
  document_id String
  shreno_doc_no String?
  shreno_reference_no String?
  client_doc_no String?
  client_reference_no String?
  upload_due_days Int?
  response_due_days Int?
  actual_due_days Int?
  user_id String?
  status String @default("Pending") // Pending, Uploaded, Approved, Rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id])
  group group @relation(fields: [group_id], references: [id])
  document document_master @relation(fields: [document_id], references: [id])
  user user? @relation(fields: [user_id], references: [id])
  customer customer @relation(fields: [customer_id], references: [id])
  customer_location customer_location @relation(fields: [customer_location_id], references: [id])
  po po @relation(fields: [po_id], references: [id])
  versions document_version[]
  transmission_items transmission_document[]
  activities document_activity[]
}




model weld_joint_plan {
  id                  String   @id @default(uuid())
  company_id          String
  job_id              String
  
  shreno_drg_no       String
  customer_drg_no     String?
  code_of_construction String
  weld_plan_no        String
  serial_no           Int
  
  company   company @relation(fields: [company_id], references: [id])
  job       job     @relation(fields: [job_id], references: [id])
  
  weld_joints weld_joint[]
  
  created_by          String?
  creator             user?   @relation(fields: [created_by], references: [id])

  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model weld_joint {
  id                      String   @id @default(uuid())
  weld_joint_plan_id      String
  
  joint_no                String
  joint_type              String
  joint_description       String
  
  base_metal_thickness_p1 String?
  base_metal_thickness_p2 String?
  
  base_metal_spec_p1      String?
  base_metal_spec_p2      String?
  
  consumable              String?
  wps_pqr_no              String?
  process                 String?
  impact_test             String?
  
  back_chip_req           Boolean?
  pwht                    Boolean?
  rt                      Boolean?
  pt                      Boolean?
  remarks                 String?
  
  weld_joint_plan weld_joint_plan @relation(fields: [weld_joint_plan_id], references: [id], onDelete: Cascade)
  weld_joint_report_info weld_joint_report_info?
  weld_joint_stages weld_joint_stage[]
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model weld_joint_report_info {
  id              String   @id @default(uuid())
  weld_joint_id   String   @unique
  weld_joint      weld_joint @relation(fields: [weld_joint_id], references: [id], onDelete: Cascade)

  report_no       String?
  tag_no          String?
  equipment       String?
  projects_id     String?
  linde_drg_no    String?
  drg_no          String?
  code            String?
  insp_agency     String?
}

model weld_joint_stage {
  id              String   @id @default(uuid())
  weld_joint_id   String   
  weld_joint      weld_joint @relation(fields: [weld_joint_id], references: [id], onDelete: Cascade)

  stage_name      String   // e.g. "s1", "s2", "s3"
  status          String   @default("pending") // pending, submitted, approved, rejected
  
  prod_eng_id     String?
  prod_eng        user?    @relation("WeldStageProdEng", fields: [prod_eng_id], references: [id])
  qc_eng_id       String?
  qc_eng          user?    @relation("WeldStageQcEng", fields: [qc_eng_id], references: [id])
  
  submitted_at    DateTime?
  approved_at     DateTime?
  rejected_at     DateTime?
  remarks         String?
  is_active       Boolean  @default(true)
  
  assigned_qc_group_id String?
  assigned_qc_group    qc_group? @relation(fields: [assigned_qc_group_id], references: [id])

  stage_data      weld_joint_stage_data?
  stage_rows      weld_joint_stage_row[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weld_joint_id, stage_name])
}

model weld_joint_stage_data {
  id                      String   @id @default(uuid())
  weld_joint_stage_id     String   @unique
  weld_joint_stage        weld_joint_stage @relation(fields: [weld_joint_stage_id], references: [id], onDelete: Cascade)

  material_id_marks       String?
  nozzle_number           String?
  tack_welder             String?
  visual_inspection       String?
  l_seam_rt               String?
  nozzle_size             String?
  total_length            String?
  welder_number           String?
  overlay_pt              String?
  opening_size            String?
  orientation             String?
  elevation               String?
  edge_preparation        String?
  material_id             String?
  l_seam_ndt              String?
  cleaning                String?
  groove_angle            String?
  root_face               String?
  root_gap                String?
  projection              String?
  pcd_hole                String?
  rf_pad                  String?
  fillet_size             String?
  welding_process         String?
  rf_pad_pneumatic        String?
  post_rt_status          String?
  post_pt_status          String?
  date                    String?
  assigned_ndt_engineer_id String?
  rt_status               String?
  rt_remark               String?
}

model weld_joint_stage_row {
  id                      String   @id @default(uuid())
  weld_joint_stage_id     String   
  weld_joint_stage        weld_joint_stage @relation(fields: [weld_joint_stage_id], references: [id], onDelete: Cascade)

  sr_no                   Int
  row_name                String
  row_value               String?
}

model document_version {
  id                 String   @id @default(uuid())
  single_document_id String?
  group_document_id  String?
  version_no         Int
  file_url           String
  file_path          String?   // User requirement: filePath
  file_hash          String?   // User requirement: fileHash
  file_size          Int?      // User requirement: fileSize
  mime_type          String?   // User requirement: mimeType
  is_active          Boolean  @default(true) // User requirement: isActive
  remarks            String?
  status             String   @default("Uploaded") // Uploaded, Approved, Rejected
  uploaded_by        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  single_document single_document? @relation(fields: [single_document_id], references: [id])
  group_document  group_document?  @relation(fields: [group_document_id], references: [id])
  uploader        user?            @relation(fields: [uploaded_by], references: [id])
  transmission_items transmission_document[]
}

model document_access_log {
  id          String   @id @default(uuid())
  document_id String
  action      String   // UPLOAD, DOWNLOAD, VIEW
  user_id     String?
  timestamp   DateTime @default(now())
}

model transmission {
  id                   String   @id @default(uuid())
  company_id           String
  transmission_number  String   @unique
  customer_id          String
  customer_location_id String
  po_id                String
  zip_url              String?
  client_archive_url   String?
  password             String
  status               String @default("Pending") // Pending, Sent
  client_status        String @default("Pending") // Pending, Approved, Rejected
  client_remarks       String?
  created_by           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company   company           @relation(fields: [company_id], references: [id])
  customer  customer          @relation(fields: [customer_id], references: [id])
  location  customer_location @relation(fields: [customer_location_id], references: [id])
  po        po                @relation(fields: [po_id], references: [id])
  creator   user              @relation(fields: [created_by], references: [id])
  documents transmission_document[]
  activities document_activity[]
}

model document_activity {
  id                String   @id @default(uuid())
  company_id        String
  group_document_id String?
  transmission_id   String?
  user_id          String
  action           String   // Assigned, Uploaded, Internal Approved, Internal Rejected, Transmitted, Client Approved, Client Rejected
  remarks          String?
  metadata         Json?
  createdAt        DateTime @default(now())

  company          company          @relation(fields: [company_id], references: [id])
  group_document  group_document? @relation(fields: [group_document_id], references: [id])
  transmission    transmission?    @relation(fields: [transmission_id], references: [id])
  user            user             @relation(fields: [user_id], references: [id])
}

model transmission_document {
  id                 String @id @default(uuid())
  transmission_id    String
  single_document_id String?
  group_document_id  String?
  version_id         String
  client_status      String @default("Pending")  // Pending, Approved, Rejected, Commented
  client_remarks     String?

  transmission    transmission     @relation(fields: [transmission_id], references: [id])
  single_document single_document? @relation(fields: [single_document_id], references: [id])
  group_document  group_document?  @relation(fields: [group_document_id], references: [id])
  version         document_version @relation(fields: [version_id], references: [id])
}

model drawing_transmittal {
  id                    String   @id @default(uuid())
  company_id            String
  ref_no                String   @unique
  date                  DateTime @default(now())
  customer_id           String?
  customer_location_id  String?
  po_id                 String?
  
  // Flattened metadata
  client_name           String?
  po_number             String?
  project_id            String?
  equipment_name        String?
  tag_no                String?
  code                  String?

  // Issued To
  to_hm                Boolean  @default(false)
  to_hq                Boolean  @default(false)
  to_hmf               Boolean  @default(false)
  to_hpl               Boolean  @default(false)
  to_hst               Boolean  @default(false)
  to_hpc               Boolean  @default(false)
  to_ppd               Boolean  @default(false)

  // Issued For
  for_reference        Boolean  @default(false)
  for_planning         Boolean  @default(false)
  for_construction     Boolean  @default(false)
  for_manufacturing    Boolean  @default(false)
  for_outsourcing      Boolean  @default(false)
  for_procurement      Boolean  @default(false)
  
  status                String   @default("Draft")
  created_by            String
  
  company               company  @relation(fields: [company_id], references: [id])
  creator               user     @relation(fields: [created_by], references: [id])
  
  jobs                  drawing_transmittal_job[]
  items                 drawing_transmittal_item[]

  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model drawing_transmittal_job {
  id                    String   @id @default(uuid())
  dtn_id                String
  job_id                String
  
  dtn                   drawing_transmittal @relation(fields: [dtn_id], references: [id], onDelete: Cascade)
  job                   job                 @relation(fields: [job_id], references: [id])

  @@unique([dtn_id, job_id])
}

model drawing_transmittal_item {
  id                    String   @id @default(uuid())
  dtn_id                String
  sr_no                 String
  doc_no_title          String
  document_master_id    String?
  rev                   String?
  copies                String?
  
  // Matrix
  dist_hm               Boolean  @default(false)
  dist_hq               Boolean  @default(false)
  dist_hmf              Boolean  @default(false)
  dist_hpl              Boolean  @default(false)
  dist_hst              Boolean  @default(false)
  dist_hpc              Boolean  @default(false)
  dist_ppd              Boolean  @default(false)

  dtn                   drawing_transmittal @relation(fields: [dtn_id], references: [id], onDelete: Cascade)
  document              document_master?    @relation(fields: [document_master_id], references: [id])
}

// New Model for storing drawing revisions (DTN Native)
model drawing_version {
  id                 String   @id @default(uuid())
  document_master_id String
  version_no         Int      
  file_url           String
  file_path          String?
  file_hash          String?
  file_size          Int?
  mime_type          String?
  is_active          Boolean  @default(true)
